<% active = current_page?(url) %>
<li class="kalo-nav__item">
  <%= link_to(url, class: "kalo-nav__link#{' is-active' if active}", 'aria-current': (active ? 'page' : nil)) do %>
    <svg width="18" height="18" aria-hidden="true"><use xlink:href="#<%= icon %>" /></svg>
    <span><%= label %></span>
  <% end %>
</li>
