<%#
# Navigation (Kalo)

Grouped sidebar built from SuperAdmin::KaloNavigation.groups.
Collapses into a top bar with a menu button on narrow screens.
%>

<%= vite_client_tag %>
<%= vite_javascript_tag 'superadmin_pages' %>

<aside class="kalo-nav">
  <div class="kalo-nav__bar">
    <%= link_to super_admin_root_path, class: 'kalo-brand', 'aria-label': SuperAdmin::KaloNavigation.brand_name do %>
      <img src="/brand-assets/kalo-mark.svg" alt="" class="kalo-brand__mark" width="36" height="36">
      <span class="kalo-brand__text">
        <span class="kalo-brand__name"><%= SuperAdmin::KaloNavigation.brand_name %></span>
        <span class="kalo-brand__sub"><%= t('kalo_super_admin.brand_subtitle') %></span>
      </span>
    <% end %>
  </div>

  <details class="kalo-nav__drawer" id="kalo-nav-drawer" open>
    <summary class="kalo-nav__toggle">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 5h14M3 10h14M3 15h14"/></svg>
      <span><%= t('kalo_super_admin.nav.label') %></span>
    </summary>

    <nav class="kalo-nav__body" aria-label="<%= t('kalo_super_admin.nav.label') %>">
      <% SuperAdmin::KaloNavigation.groups(self).each do |group| %>
        <div class="kalo-nav__group">
          <p class="kalo-nav__heading"><%= group[:title] %></p>
          <ul class="kalo-nav__list">
            <% group[:items].each do |item| %>
              <%= render partial: "nav_item", locals: { icon: item[:icon], url: item[:url], label: item[:label] } %>
            <% end %>
            <% if group[:key] == :system %>
              <%= render 'settings_menu', open: settings_open? %>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="kalo-nav__group kalo-nav__group--footer">
        <ul class="kalo-nav__list">
          <%= render partial: "nav_item", locals: { icon: 'icon-apps-2-line', url: '/app/platform/overview', label: t('kalo_super_admin.nav.console') } %>
          <%= render partial: "nav_item", locals: { icon: 'icon-mail-send-fill', url: '/app/platform/emails', label: t('kalo_super_admin.nav.mail_inspector') } %>
          <%= render partial: "nav_item", locals: { icon: 'icon-mist-fill', url: sidekiq_web_url, label: t('kalo_super_admin.nav.sidekiq') } %>
          <%= render partial: "nav_item", locals: { icon: 'icon-dashboard-line', url: '/', label: t('kalo_super_admin.nav.agent_dashboard') } %>
          <%= render partial: "nav_item", locals: { icon: 'icon-logout-circle-r-line', url: super_admin_logout_path, label: t('kalo_super_admin.nav.logout') } %>
        </ul>
      </div>
    </nav>
  </details>
</aside>

<script>
  // Menu starts closed on narrow screens, open on desktop.
  (function () {
    var drawer = document.getElementById('kalo-nav-drawer');
    if (drawer && window.matchMedia('(max-width: 767px)').matches) drawer.removeAttribute('open');
  })();
</script>
