<li class="kalo-nav__item">
  <details class="kalo-nav__sub" <%= 'open' if open %>>
    <summary class="kalo-nav__link<%= ' is-active' if open %>">
      <svg width="18" height="18" aria-hidden="true"><use xlink:href="#icon-settings-2-line" /></svg>
      <%= link_to t('kalo_super_admin.nav.settings'), super_admin_settings_path, class: 'kalo-nav__sub-link' %>
      <svg class="kalo-nav__caret" width="16" height="16" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
      </svg>
    </summary>
    <ul class="kalo-nav__list kalo-nav__list--sub">
      <% settings_pages.each do |_feature_key, attrs| %>
        <% url = super_admin_app_config_path(config: attrs['config_key']) %>
        <li class="kalo-nav__item">
          <%= link_to attrs['name'], url, class: "kalo-nav__link#{' is-active' if current_page?(url)}", 'aria-current': (current_page?(url) ? 'page' : nil) %>
        </li>
      <% end %>
    </ul>
  </details>
</li>
