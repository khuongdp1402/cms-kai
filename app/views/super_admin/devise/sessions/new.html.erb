<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= t('kalo_super_admin.login.title') %> - <%= SuperAdmin::KaloNavigation.brand_name %></title>
    <link rel="icon" type="image/svg+xml" href="/brand-assets/kalo-mark.svg">
    <% Administrate::Engine.stylesheets.each do |css_path| %>
      <%= stylesheet_link_tag css_path %>
    <% end %>
    <%= vite_client_tag %>
    <%= vite_javascript_tag 'superadmin' %>
  </head>
  <body class="kalo-admin kalo-login">
    <main class="kalo-login__main">
      <section class="kalo-login__brand">
        <img src="/brand-assets/kalo-mark.svg" alt="" width="56" height="56">
        <h1 class="kalo-login__title"><%= t('kalo_super_admin.login.title') %></h1>
        <p class="kalo-login__subtitle"><%= t('kalo_super_admin.login.subtitle') %></p>
      </section>
      <section class="kalo-login__card">
        <%= form_for(resource, as: resource_name, url: '/super_admin/sign_in') do |f| %>
          <% if flash[:error].present? %>
            <div data-alert role="alert" class="kalo-login__error"><%= flash[:error] %></div>
          <% end %>
          <div class="kalo-field">
            <%= f.label :email, t('kalo_super_admin.login.email'), for: 'email_address', class: 'kalo-field__label' %>
            <%= f.email_field :email, id: 'email_address', autofocus: true, autocomplete: 'email', required: true, placeholder: t('kalo_super_admin.login.email_placeholder'), class: 'kalo-field__input' %>
          </div>
          <div class="kalo-field">
            <%= f.label :password, t('kalo_super_admin.login.password'), for: 'password', class: 'kalo-field__label' %>
            <%= f.password_field :password, id: 'password', autocomplete: 'current-password', required: true, placeholder: t('kalo_super_admin.login.password_placeholder'), class: 'kalo-field__input' %>
          </div>
          <button type="submit" class="kalo-login__submit"><%= t('kalo_super_admin.login.submit') %></button>
        <% end %>
      </section>
    </main>
  </body>
</html>
