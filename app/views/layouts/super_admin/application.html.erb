<%#
# Application Layout (Kalo)

Layout for every page Administrate generates: navigation, flashes,
stylesheets and scripts. Styled by administrate/kalo.scss (see ADR-020).
%>

<!DOCTYPE html>
<html lang="<%= I18n.locale %>" class="w-full h-full">
<head>
  <meta charset="utf-8">
  <meta name="ROBOTS" content="NOODP">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>
    <%= content_for(:title) %> - <%= SuperAdmin::KaloNavigation.brand_name %>
  </title>
  <link rel="icon" type="image/svg+xml" href="/brand-assets/kalo-mark.svg">
  <%= render "stylesheet" %>
  <%= vite_client_tag %>
  <%= vite_javascript_tag 'superadmin' %>
  <%= csrf_meta_tags %>
</head>
<body class="kalo-admin antialiased w-full h-full">
  <%= render "icons" %>
  <a class="kalo-skip" href="#kalo-main"><%= t('kalo_super_admin.skip_to_content') %></a>
  <div class="kalo-shell">
    <%= render "navigation" -%>
    <main id="kalo-main" class="kalo-main" role="main" tabindex="-1">
      <%= render "flashes" -%>
      <%= yield %>
    </main>
  </div>
  <%= render "javascript" %>
</body>
</html>
