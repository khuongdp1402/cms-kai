# deploy/k8s/secrets.yaml
# KChat K8s Secrets (P0-08 improvement) — P8 security hardening
# KHÔNG commit file này vào git. Dùng làm template và tạo secret thật bằng:
# kubectl apply -f secrets.yaml
# Hoặc dùng External Secrets Operator / HashiCorp Vault.

apiVersion: v1
kind: Secret
metadata:
  name: kchat-secrets
  namespace: kchat-production
type: Opaque
stringData:
  # Rails master key (Rails credentials)
  RAILS_MASTER_KEY: "REPLACE_ME"

  # Database
  POSTGRES_PASSWORD: "REPLACE_ME_STRONG_PASSWORD"
  DATABASE_URL: "postgresql://postgres:REPLACE_ME_STRONG_PASSWORD@kchat-postgres:5432/chatwoot_production"

  # Redis
  REDIS_PASSWORD: "REPLACE_ME_REDIS_PASSWORD"
  REDIS_URL: "redis://:REPLACE_ME_REDIS_PASSWORD@kchat-redis:6379/0"

  # Devise Token Auth
  SECRET_KEY_BASE: "REPLACE_ME_64CHAR_RANDOM_KEY"

  # Zalo Bridge
  ZALO_BRIDGE_SERVICE_SECRET: "REPLACE_ME_32BYTES_STRONG_SECRET_KEY"
  ZALO_BRIDGE_ACTIVE_KEY_ID: "k1"
  ZALO_BRIDGE_ENCRYPTION_KEYS: '{"k1":"REPLACE_ME_64CHAR_HEX_KEY"}'

  # CORS Whitelist
  ALLOWED_ORIGINS: "https://cms.ktech.vn,https://api.ktech.vn"
  ACTION_CABLE_ALLOWED_ORIGINS: "https://cms.ktech.vn"

  # Mailer
  SMTP_USERNAME: "REPLACE_ME"
  SMTP_PASSWORD: "REPLACE_ME"

  # Optional: Sentry DSN
  SENTRY_DSN: "REPLACE_ME"
