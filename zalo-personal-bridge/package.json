{
  "name": "zalo-personal-bridge",
  "version": "2.0.0",
  "description": "Multi-Session Native Zalo Personal Bridge for Chatwoot",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('src/persistence/postgres/migrations', 'dist/persistence/postgres/migrations', { recursive: true })\"",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/type-provider-typebox": "^4.0.0",
    "@sinclair/typebox": "^0.32.34",
    "dotenv": "^16.4.7",
    "fastify": "^4.28.1",
    "file-type": "^19.0.0",
    "ioredis": "^5.4.1",
    "pg": "^8.12.0",
    "pino": "^9.2.0",
    "pino-pretty": "^11.2.1",
    "prom-client": "^15.1.3",
    "sharp": "^0.33.4",
    "undici": "^6.19.2",
    "zca-js": "2.1.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "tsx": "^4.16.0",
    "typescript": "^5.5.2",
    "vitest": "^1.6.0"
  }
}
