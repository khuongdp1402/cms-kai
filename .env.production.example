# Kalo production configuration. Copy to .env.production and replace every CHANGE_ME.
# Never commit .env.production. Use alphanumeric secrets (no @ : / # % characters) so they are safe inside URLs.

# --- Domain ---
KALO_DOMAIN=example.vn
FRONTEND_URL=https://app.example.vn
CORS_ALLOWED_ORIGINS=https://app.example.vn
INSTALLATION_NAME=Kalo
ENABLE_ACCOUNT_SIGNUP=false

# --- Rails ---
# Generate with: openssl rand -hex 64
SECRET_KEY_BASE=CHANGE_ME

# --- Postgres ---
POSTGRES_DATABASE=chatwoot_production
POSTGRES_USERNAME=kalo
POSTGRES_PASSWORD=CHANGE_ME

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME

# --- Casso (bank transfer webhook) ---
CASSO_SECURE_TOKEN=CHANGE_ME
CASSO_BANK_NAME=CHANGE_ME
CASSO_ACCOUNT_NUMBER=CHANGE_ME
CASSO_ACCOUNT_NAME=CHANGE_ME

# --- AI gateway ---
AGENTGW_BASE_URL=https://CHANGE_ME
AGENTGW_API_KEY=CHANGE_ME

# --- Zalo bridge (secret must be >= 32 chars; keys are generated per deployment) ---
ZALO_BRIDGE_SERVICE_SECRET=CHANGE_ME
ZALO_BRIDGE_ACTIVE_KEY_ID=k1
ZALO_BRIDGE_ENCRYPTION_KEYS=CHANGE_ME

# --- Mail ---
MAILER_SENDER_EMAIL=Kalo <no-reply@example.vn>
SMTP_DOMAIN=example.vn
SMTP_ADDRESS=smtp.example.vn
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME

# --- File storage (local = Docker volume `storage_data`) ---
ACTIVE_STORAGE_SERVICE=local

# --- Optional: image tags ---
# KALO_IMAGE=kalo-rails:latest
# KALO_BRIDGE_IMAGE=kalo-zalo-bridge:latest
